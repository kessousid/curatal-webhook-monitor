PORT=3000
DATABASE_URL=

# The endpoint to health-check. Ideally a lightweight /health route on the same
# host/process as your Razorpay webhook receiver (so a crashed process or a down
# host is caught), rather than the Razorpay POST route itself.
WEBHOOK_ENDPOINT_URL=https://portal.curatal.com/api/webhooks/razorpay

HEALTH_CHECK_INTERVAL_MINUTES=5
HEALTH_CHECK_FAILURE_THRESHOLD=3
HEALTH_CHECK_TIMEOUT_MS=10000

REALERT_MINUTES=60

# How often to email a routine status digest (Razorpay payment activity,
# webhook heartbeat recency, receiver health), regardless of whether anything
# is failing. Capped at one send per this many hours (persisted in digest_log,
# so restarts can't cause extra sends).
DIGEST_INTERVAL_HOURS=24

ALERT_EMAIL_TO=
ALERT_EMAIL_CC=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: separate recipients for the daily digest (comma-separated for
# multiple addresses). Both fall back to ALERT_EMAIL_TO/ALERT_EMAIL_CC if unset.
DIGEST_EMAIL_TO=
DIGEST_EMAIL_CC=

# Optional: enables Razorpay payment reporting in the daily digest (whether
# any payments were made, and whether webhooks were received for them). Leave
# blank to disable this feature entirely — the digest will note it's unconfigured.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
